{% macro water(className = "") %}
<div class="water-still{% if className %} {{ className }}{% endif %}" aria-hidden="true">
  {# Position, diameter, duration, initial offset and horizontal drift. #}
  {% set bubbles = [
    [3, 3, 8, -3, 8], [8, 6, 11, -8, -10], [13, 4, 9, -1, 12],
    [19, 2, 7, -5, -6], [25, 5, 12, -7, 10], [31, 3, 9, -4, -14],
    [37, 7, 13, -11, 9], [43, 3, 10, -2, -8], [49, 4, 8, -6, 12],
    [55, 2, 11, -5, -9], [61, 6, 12, -9, 14], [67, 3, 8, -2, -10],
    [73, 5, 10, -7, 8], [79, 2, 9, -4, -12], [85, 7, 13, -3, 10],
    [91, 4, 11, -8, -8], [96, 3, 8, -5, -10]
  ] %}
  {% for bubble in bubbles %}
  <span class="water-bubble" style="--bubble-left: {{ bubble[0] }}%; --bubble-size: {{ bubble[1] }}px; --bubble-duration: {{ bubble[2] }}s; --bubble-delay: {{ bubble[3] }}s; --bubble-drift: {{ bubble[4] }}px;"></span>
  {% endfor %}
</div>
{% endmacro %}
